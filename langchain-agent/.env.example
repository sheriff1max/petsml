# Скопируйте в .env и заполните
OLLAMA_API_KEY=...

# Модель меняется одной строкой, примеры:
#   anthropic:claude-sonnet-5      (нужен langchain-anthropic и ANTHROPIC_API_KEY)
#   google_genai:gemini-2.5-flash  (нужен langchain-google-genai и GOOGLE_API_KEY)
#   ollama:llama3.2                (локально, без ключей)
MODEL=ollama:nemotron-3-nano:30b
